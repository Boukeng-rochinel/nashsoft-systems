# --- Website assistant (Gemini) — SERVER-SIDE ONLY, never prefix with VITE_ ---
# Create a key at https://aistudio.google.com/apikey and set it in .env.local (dev)
# and in your hosting provider's environment variables (production).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional backend endpoints. When unset, forms fall back to a pre-filled e-mail (mailto).
# Each endpoint receives a JSON POST body.
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
