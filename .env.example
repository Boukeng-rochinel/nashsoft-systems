# --- Website assistant (Gemini) — SERVER-SIDE ONLY, never prefix with VITE_ ---
# Create a key at https://aistudio.google.com/apikey and set it in .env.local (dev)
# and in the server's .env (production).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# --- Contact forms → backend (server/index.ts) ---
# When unset, forms fall back to a pre-filled e-mail (mailto) and no captcha is shown.
# Production on the VPS: /api/contact (proxied by Nginx to the Node API server).
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=

# --- Cloudflare Turnstile (anti-bot) — https://dash.cloudflare.com → Turnstile ---
# Site key is public (bundled into the site). Secret key is SERVER-SIDE ONLY.
# Local testing: Cloudflare's always-pass test keys
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP used to e-mail contact requests — SERVER-SIDE ONLY ---
# Port 465 = implicit TLS, 587 = STARTTLS (SMTP_SECURE is inferred from the port when empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Inbox that receives requests, and sender address (both default to SMTP_USER).
CONTACT_TO=contact@nashsoft.cm
CONTACT_FROM=

# --- Node API server (server/index.ts) ---
API_PORT=3001
API_HOST=127.0.0.1
